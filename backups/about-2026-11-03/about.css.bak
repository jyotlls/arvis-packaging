/* =========================================================
   ABOUT PAGE
   Mobile-first. Pinned / scroll-linked storytelling is layered on
   at >= 992px when motion is allowed (see the media query at the end).
   Scroll-linked sections receive --p (0–1) from AboutPage.tsx.
   ========================================================= */

/* one-class weight: beats Bootstrap's list padding, loses to each list's own rules below */
:where(ol, ul)[class^="ab-"] {
    list-style: none;
    margin: 0;
    padding: 0
}

/* reveal on enter */
[data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity .9s ease, transform .9s cubic-bezier(.2, .8, .2, 1)
}

[data-reveal].is-in {
    opacity: 1;
    transform: none
}

/* ---------- ABOUT US ---------- */
.ab-hero {
    position: relative;
    display: grid;
    gap: 56px;
    padding: 70px 20px 90px;
    overflow: hidden;
    isolation: isolate
}

/* each headline line rises out of its own mask */
.ab-line {
    display: block;
    overflow: hidden;
    padding-bottom: .06em
}

.ab-line > * {
    display: block;
    animation: abRise 1.1s cubic-bezier(.2, .8, .2, 1) both
}

.ab-line + .ab-line > * {
    animation-delay: .15s
}

/* height comes from the image, so the swatch stays on its corner at every width */
.ab-hero-visual {
    position: relative;
    padding-bottom: 34px
}

.ab-hero-lead {
    max-width: 800px
}

/* the photo file has transparent edges; zoom past them so it fills its frame */
.ab-hero-visual .hero-visual {
    border-radius: 40px 15% 40px 40px / 40px 18.5% 40px 40px
}

.ab-hero-visual .hero-visual img {
    display: block;
    border-radius: 0;
    transform: scale(1.1)
}


/* die-cut frame: a clipped corner like a carton tuck flap */
.ab-hero-frame {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, calc(100% - 64px) 0, 100% 64px, 100% 100%, 0 100%);
    overflow: hidden
}

.ab-hero-frame img {
    object-fit: cover;
    animation: abSettle 2.4s cubic-bezier(.2, .8, .2, 1) both
}

/* image mask reveal */
.ab-hero-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--off);
    transform-origin: top;
    animation: abUnmask 1.3s .2s cubic-bezier(.7, 0, .2, 1) both
}

.ab-hero-swatch {
    position: absolute;
    left: 14px;
    bottom: 0;
    width: 40%;
    aspect-ratio: 4 / 3;
    border: 5px solid #fff;
    border-radius: 18px;
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 24px 44px -20px rgba(7, 61, 105, .55);
    animation: abRise 1.1s .7s cubic-bezier(.2, .8, .2, 1) both
}

.ab-hero-swatch img {
    object-fit: cover
}

/* ---------- MANUFACTURING FACILITIES (slider) ---------- */
.ab-facility {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 600px;
    padding: 90px 20px 150px;
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
    color: #fff
}

.ab-facility-slide {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.2s ease
}

.ab-facility-slide.is-active {
    opacity: 1
}

/* slow push-in on the visible slide */
.ab-facility-slide img {
    object-fit: cover;
    object-position: 100% center;
    transform: scale(1.1);
    transition: transform 8s linear
}

.ab-facility-slide.is-active img {
    transform: scale(1)
}

.ab-facility::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(12, 35, 53, .95) 0%, rgba(12, 35, 53, .78) 45%, rgba(12, 35, 53, .12) 100%)
}

.ab-facility-copy {
    position: relative;
    max-width: 640px
}

.ab-facility .eyebrow {
    color: var(--mint)
}

.ab-facility .brand-lines::before,
.ab-facility .brand-lines::after {
    background: var(--mint)
}

.ab-facility-text {
    margin: 24px 0 38px;
    font-family: var(--font-manrope), sans-serif;
    font-size: clamp(1.6rem, 6.4vw, 2rem);
    font-weight: 500;
    line-height: 1.32;
    color: #fff;
    animation: abFade .9s cubic-bezier(.2, .8, .2, 1) both
}

.ab-facility-controls {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 34px;
    display: flex;
    align-items: center;
    gap: 14px
}

.ab-facility-controls > button {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .4);
    background: none;
    color: #fff;
    cursor: pointer;
    transition: background .3s ease, border-color .3s ease, color .3s ease
}

.ab-facility-controls > button:hover,
.ab-facility-controls > button:focus-visible {
    background: var(--kraft);
    border-color: var(--kraft);
    color: var(--ink)
}

.ab-facility-dots {
    display: flex;
    gap: 8px
}

/* each dot is a small track that fills while its slide is showing */
.ab-facility-dots button {
    position: relative;
    width: 52px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer
}

.ab-facility-dots button::before,
.ab-facility-dots i {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px
}

.ab-facility-dots button::before {
    right: 0;
    background: rgba(255, 255, 255, .3)
}

.ab-facility-dots i {
    width: 0;
    background: var(--kraft)
}

.ab-facility-dots button.is-active i {
    animation: abFill 7s linear forwards
}

.ab-facility-dots i.is-paused {
    animation-play-state: paused
}

.ab-facility-count {
    margin: 0 0 0 auto;
    font-family: var(--font-manrope), sans-serif;
    white-space: nowrap;
    color: #fff
}

.ab-facility-count strong {
    font-size: 2.4rem;
    font-weight: 600
}

.ab-facility-count small {
    font-size: 16px;
    color: rgba(255, 255, 255, .55)
}

/* ---------- MISSION + VISION ---------- */
.ab-mv {
    display: grid
}

.ab-mv-side {
    position: relative;
    padding: 80px 20px 130px;
    overflow: hidden;
    isolation: isolate
}

.ab-mv-mission {
    background:
        radial-gradient(circle at 85% 10%, rgba(200, 168, 116, .2), transparent 45%),
        var(--navy);
    color: #fff
}

.ab-mv-vision {
    background: var(--off)
}

.ab-mv h2 {
    margin: 0
}

.ab-mv-mission h2 {
    color: #fff
}

/* huge outlined word sitting behind each statement */
.ab-mv-word {
    position: absolute;
    z-index: -1;
    left: 12px;
    bottom: -.14em;
    font-family: var(--font-manrope), sans-serif;
    font-size: clamp(5rem, 26vw, 7.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(7, 61, 105, .14);
    pointer-events: none;
    transition: transform 1s cubic-bezier(.2, .8, .2, 1), -webkit-text-stroke-color .6s ease
}

.ab-mv-mission .ab-mv-word {
    -webkit-text-stroke-color: rgba(255, 255, 255, .14)
}

/* icon badge with a dashed gold ring that turns on hover */
.ab-mv-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 28px;
    border-radius: 50%;
    border: 1px solid rgba(200, 168, 116, .55);
    background: rgba(255, 255, 255, .06);
    color: var(--kraft);
    transition: background .4s ease, color .4s ease, transform .5s cubic-bezier(.2, .8, .2, 1)
}

.ab-mv-vision .ab-mv-icon {
    background: #fff;
    color: var(--navy)
}

.ab-mv-icon::after {
    content: "";
    position: absolute;
    inset: -9px;
    border-radius: 50%;
    border: 1px dashed rgba(200, 168, 116, .6);
    transition: transform 1.2s cubic-bezier(.2, .8, .2, 1)
}

.ab-mv-side:hover .ab-mv-icon {
    background: var(--kraft);
    color: var(--ink);
    transform: translateY(-4px)
}

.ab-mv-side:hover .ab-mv-icon::after {
    transform: rotate(180deg)
}

.ab-mv blockquote {
    position: relative;
    margin: 22px 0 0;
    padding-top: 26px;
    font-family: var(--font-manrope), sans-serif;
    font-size: clamp(1.15rem, 4.6vw, 1.35rem);
    font-weight: 500;
    line-height: 1.6;
    color: var(--navy)
}

/* short gold rule above each statement that stretches on hover */
.ab-mv blockquote::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 48px;
    height: 2px;
    background: var(--kraft);
    transition: width .7s cubic-bezier(.2, .8, .2, 1)
}

.ab-mv-side:hover blockquote::before {
    width: 140px
}

.ab-mv-mission blockquote {
    color: #fff
}

.ab-mv blockquote em {
    font-style: normal;
    color: var(--kraft)
}

/* ---------- CERTIFICATIONS (orbit) ---------- */
.ab-certs {
    position: relative;
    padding: 70px 20px;
    overflow: hidden;
    text-align: center;
    background: radial-gradient(circle at 50% 62%, rgba(200, 168, 116, .14), transparent 45%), #fff
}

.ab-certs-head .eyebrow {
    justify-content: center
}

.ab-certs-intro {
    max-width: 520px;
    margin: 0 auto
}

.ab-orbit {
    position: relative;
    margin-top: 44px
}

.ab-orbit-ring {
    display: none
}

/* central seal */
.ab-orbit-core {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    width: 170px;
    height: 170px;
    margin: 0 auto 34px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--kraft);
    box-shadow: 0 0 0 10px rgba(7, 61, 105, .06), 0 30px 60px -25px rgba(7, 61, 105, .6)
}

.ab-orbit-seal {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    overflow: visible;
    animation: abSpin 22s linear infinite
}

.ab-orbit-core text {
    font-family: var(--font-inter), sans-serif;
    font-size: 8.4px;
    font-weight: 600;
    letter-spacing: .2em;
    fill: rgba(255, 255, 255, .75)
}

.ab-orbit-core strong {
    font-family: var(--font-manrope), sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #fff
}

/* phones: a simple two-column wall */
.ab-orbit-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none
}

.ab-orbit-list li {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .7s ease var(--d, 0s), transform .6s cubic-bezier(.2, .8, .2, 1) var(--d, 0s)
}

.ab-orbit.is-in .ab-orbit-list li {
    opacity: 1;
    transform: none
}

/* certificate card */
.ab-cert-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 150px;
    padding: 20px 12px;
    border: 1px solid rgba(7, 61, 105, .1);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 40px -28px rgba(7, 61, 105, .45);
    transform: perspective(700px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg)) translateY(var(--lift, 0px));
    transition: transform .6s cubic-bezier(.2, .8, .2, 1), box-shadow .5s ease, border-color .4s ease
}

.ab-cert-card:hover {
    --lift: -6px;
    border-color: var(--kraft);
    box-shadow: 0 28px 50px -26px rgba(7, 61, 105, .55);
    transition: transform .15s ease-out, box-shadow .5s ease, border-color .4s ease
}

/* soft gold spotlight that follows the pointer (under the logo so its white background blends away) */
.ab-cert-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(200, 168, 116, .22), transparent 60%);
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none
}

.ab-cert-card:hover::before {
    opacity: 1
}

.ab-cert-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 72px
}

/* width/height come from the Image props (already fitted to 120x72) */
.ab-cert-logo img {
    mix-blend-mode: multiply;
    transition: transform .5s cubic-bezier(.2, .8, .2, 1)
}

/* scale the image itself: a transformed wrapper would isolate it and break the multiply blend */
.ab-cert-card:hover .ab-cert-logo img {
    transform: scale(1.08)
}

.ab-cert-name {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--navy);
    transition: color .3s ease
}

.ab-cert-card:hover .ab-cert-name {
    color: #8a6a35
}

/* ---------- WHY CHOOSE US ---------- */
.ab-why {
    padding: 70px 20px;
    background: #fff
}

.ab-why-head {
    display: grid;
    gap: 20px;
    margin-bottom: 44px
}

.ab-why h2 {
    margin: 0
}

/* tall photo panels: copy sits on a dark fade, a gold rule runs out on hover */
.ab-why-list {
    display: grid;
    gap: 14px
}

.ab-why-list li {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    overflow: hidden;
    isolation: isolate;
    border-radius: 20px;
    background: var(--ink);
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .9s ease calc(var(--i) * 130ms), transform 1.1s cubic-bezier(.2, .8, .2, 1) calc(var(--i) * 130ms)
}

.ab-why-list.is-in li {
    opacity: 1;
    transform: none
}

/* one monochrome grade so mixed photos read as a set; colour returns on hover */
.ab-why-list img {
    z-index: -2;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08) brightness(.82);
    transition: transform 1.8s cubic-bezier(.2, .8, .2, 1), filter .9s ease
}

.ab-why-list li:hover img {
    filter: none;
    transform: scale(1.07)
}

.ab-why-list li::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(7, 61, 105, .38) 0%, rgba(7, 61, 105, .52) 42%, rgba(12, 35, 53, .97) 100%);
    transition: opacity .9s ease
}

.ab-why-list li:hover::after {
    opacity: .82
}

.ab-why-body {
    width: 100%;
    padding: 30px 28px
}

.ab-why-num {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    font-family: var(--font-manrope), sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .2em;
    color: var(--kraft)
}

.ab-why-num::after {
    content: "";
    flex: 0 0 36px;
    height: 1px;
    background: var(--kraft);
    transition: flex-basis .9s cubic-bezier(.2, .8, .2, 1)
}

.ab-why-list li:hover .ab-why-num::after {
    flex-basis: calc(100% - 44px)
}

.ab-why-list h3 {
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -.01em;
    color: #fff
}

.ab-why-list p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, .76)
}

/* ---------- SUSTAINABILITY ---------- */
.ab-sustain {
    display: grid;
    gap: 50px;
    padding: 70px 20px;
    background: #fff
}

.ab-sustain-visual {
    position: relative
}

/* arch-shaped photo window */
.ab-sustain-arch {
    position: relative;
    border-radius: 80px 40px 40px 40px;
    overflow: hidden
}

/* the photo is much wider than 850x650, so lock that frame and crop into it
   (height: auto alone squashed it into a thin strip on narrow screens) */
.ab-sustain-arch img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 850 / 650;
    object-fit: cover;
    transform: scale(1.15);
    transition: transform 1.8s cubic-bezier(.2, .8, .2, 1);
    border-radius: 40px 80px 40px 40px;
}

.ab-sustain-visual.is-in .ab-sustain-arch img {
    transform: none
}

/* slowly turning circular label */
.ab-sustain-badge {
    position: absolute;
    right: 6px;
    top: 24px;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: var(--kraft);
    animation: abSpin 22s linear infinite
}

.ab-sustain-badge text {
    font-family: var(--font-inter), sans-serif;
    font-size: 9.4px;
    font-weight: 600;
    letter-spacing: .2em;
    fill: var(--ink)
}

.ab-sustain-points {
    display: grid;
    margin-top: 30px
}

.ab-sustain-points li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-manrope), sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--navy)
}

.ab-sustain-points i {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(125, 138, 74, .14);
    color: #5d6b35;
    transition: background .35s ease, color .35s ease
}

.ab-sustain-points li:hover i {
    background: var(--navy);
    color: #fff
}

/* ---------- OUR VALUES ---------- */
.ab-values {
    padding: 70px 0;
    background: #fff;
    overflow: hidden
}

.ab-values-head {
    padding: 0 20px
}

.ab-values-rows {
    display: grid;
    gap: 6px;
    margin-top: 24px
}

.ab-values-row {
    overflow: hidden
}

.ab-values-run {
    display: flex;
    width: max-content;
    animation: abMarquee 38s linear infinite
}

.ab-values-row-2 .ab-values-run {
    animation-direction: reverse;
    animation-duration: 46s
}

.ab-values-rows:hover .ab-values-run {
    animation-play-state: paused
}

.ab-values-run span {
    display: inline-flex;
    align-items: center;
    gap: .45em;
    padding-right: .45em;
    font-family: var(--font-manrope), sans-serif;
    font-size: clamp(3rem, 14vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.03em;
    color: var(--navy);
    white-space: nowrap
}

.ab-values-row-2 .ab-values-run span {
    color: transparent;
    -webkit-text-stroke: 1px rgba(7, 61, 105, .35)
}

.ab-values-run i {
    width: .16em;
    height: .16em;
    border-radius: 50%;
    background: var(--kraft)
}

/* location pin: a dot with a soft pulse */

/* the lane between both warehouses, textured like a container's corrugated wall */

/* ---------- CLOSING ---------- */
.ab-closing {
    position: relative;
    padding: 70px 20px 0;
    background: #fff;
    overflow: hidden
}

.ab-closing-mark {
    display: block;
    margin: 70px 0 -7vw;
    font-family: var(--font-manrope), sans-serif;
    font-size: 30vw;
    font-weight: 800;
    line-height: .8;
    letter-spacing: -.05em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px rgba(7, 61, 105, .14);
    user-select: none;
    pointer-events: none
}

.ab-closing h2 {
    font-size: clamp(2.3rem, 10vw, 2.8rem)
}

.ab-closing-copy p {
    max-width: 520px
}

.ab-closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 36px;
    margin-top: 32px
}

.ab-closing-actions button.button.text {
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: none;
    color: var(--ink);
    cursor: pointer
}

/* ---------- keyframes ---------- */

@keyframes abMarquee {
    from { transform: translateX(0) }
    to { transform: translateX(-50%) }
}

@keyframes abRise {
    from { transform: translateY(105%) }
    to { transform: none }
}

@keyframes abFade {
    from { opacity: 0; transform: translateY(16px) }
    to { opacity: 1; transform: none }
}

@keyframes abUnmask {
    from { transform: scaleY(1) }
    to { transform: scaleY(0) }
}

@keyframes abSettle {
    from { transform: scale(1.12) }
    to { transform: scale(1) }
}

@keyframes abDraw {
    from { stroke-dashoffset: 1 }
    to { stroke-dashoffset: 0 }
}

@keyframes abFill {
    from { width: 0 }
    to { width: 100% }
}

@keyframes abOrbit {
    to { transform: rotate(360deg) }
}

@keyframes abOrbitCounter {
    to { transform: rotate(-360deg) }
}

@keyframes abSpin {
    to { transform: rotate(360deg) }
}

/* =========================================================
   TABLET +
   ========================================================= */
@media (min-width: 768px) {
    .ab-certs {
        padding: 100px 4vw
    }

    .ab-orbit-list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px
    }

    .ab-mv-side {
        padding: 100px 4vw 150px
    }

    .ab-values-head {
        padding: 0 4vw
    }

    .ab-hero,
    .ab-facility,
    .ab-why,
    .ab-sustain {
        padding-left: 4vw;
        padding-right: 4vw
    }

    .ab-why-list {
        grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .ab-closing {
        padding: 90px 4vw 0
    }

    .ab-hero-swatch {
        left: 28px;
        width: 30%
    }

    .ab-sustain-points {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 28px
    }

}

/* =========================================================
   DESKTOP
   ========================================================= */
@media (min-width: 992px) {
    /* certifications: cards orbit a central seal */
    .ab-certs {
        --R: min(280px, 21vw);
        padding: 130px 4vw 140px
    }

    .ab-orbit {
        width: calc(var(--R) * 2 + 170px);
        height: calc(var(--R) * 2 + 160px);
        margin: 30px auto 0
    }

    .ab-orbit-ring {
        display: block;
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none
    }

    .ab-orbit-ring-1 {
        width: calc(var(--R) * 2);
        height: calc(var(--R) * 2);
        border: 1px dashed rgba(200, 168, 116, .6)
    }

    .ab-orbit-ring-2 {
        width: calc(var(--R) * 1.2);
        height: calc(var(--R) * 1.2);
        border: 1px solid rgba(7, 61, 105, .08);
        background: radial-gradient(circle, rgba(7, 61, 105, .04), transparent 70%)
    }

    .ab-orbit-core {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 210px;
        height: 210px;
        margin: 0;
        transform: translate(-50%, -50%)
    }

    .ab-orbit-core text {
        font-size: 9px
    }

    .ab-orbit-core strong {
        font-size: 15px
    }

    /* the whole ring turns slowly; hovering anywhere pauses it */
    .ab-orbit-list {
        display: block;
        position: absolute;
        inset: 0;
        animation: abOrbit 70s linear infinite
    }

    .ab-orbit:hover .ab-orbit-list,
    .ab-orbit:hover .ab-orbit-spin {
        animation-play-state: paused
    }

    .ab-orbit-list li {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 148px;
        margin: -70px 0 0 -74px;
        transform: rotate(calc(var(--i) * 360deg / var(--n))) translateX(var(--R)) rotate(calc(var(--i) * -360deg / var(--n))) scale(.6)
    }

    .ab-orbit.is-in .ab-orbit-list li {
        transform: rotate(calc(var(--i) * 360deg / var(--n))) translateX(var(--R)) rotate(calc(var(--i) * -360deg / var(--n)))
    }

    /* counter-rotation keeps every card upright while the ring turns */
    .ab-orbit-spin {
        animation: abOrbitCounter 70s linear infinite
    }

    .ab-cert-card {
        min-height: 140px
    }

    /* mission + vision: full-bleed split; the hovered half opens up */
    .ab-mv {
        display: flex;
        min-height: 80vh
    }

    .ab-mv-side {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 130px 5vw 200px;
        transition: flex-grow .8s cubic-bezier(.2, .8, .2, 1), opacity .9s ease, transform .9s cubic-bezier(.2, .8, .2, 1)
    }

    .ab-mv-side:hover {
        flex-grow: 1.25
    }

    .ab-mv-side:hover .ab-mv-word {
        transform: translateX(3vw)
    }

    .ab-mv-vision:hover .ab-mv-word {
        -webkit-text-stroke-color: rgba(200, 168, 116, .45)
    }

    .ab-mv-mission:hover .ab-mv-word {
        -webkit-text-stroke-color: rgba(200, 168, 116, .4)
    }

    .ab-mv blockquote {
        max-width: 560px;
        font-size: clamp(1.3rem, 1.6vw, 1.6rem)
    }

    .ab-mv-icon {
        width: 84px;
        height: 84px
    }

    .ab-mv-word {
        left: 4vw;
        font-size: clamp(8rem, 13vw, 13rem)
    }

    /* quality */

    /* values */
    .ab-values {
        padding: 130px 0
    }

    /* hero: same split as the homepage intro */
    .ab-hero {
        grid-template-columns: minmax(0, 54fr) minmax(0, 46fr);
        align-items: center;
        gap: clamp(32px, 4vw, 64px);
        padding-top: 100px;
        padding-bottom: 100px
    }

    .ab-hero-visual {
        padding: 0 0 44px 5%
    }

    .ab-hero-frame {
        left: 12%;
        clip-path: polygon(0 0, calc(100% - 96px) 0, 100% 96px, 100% 100%, 0 100%)
    }

    .ab-hero-swatch {
        left: 0;
        width: 36%;
        border-width: 8px;
        border-radius: 24px
    }

    /* connection lines run from the headline side into the image */

    /* facility slider */
    .ab-facility {
        min-height: min(680px, 88vh);
        padding: 120px 4vw 150px 12vw
    }

    .ab-facility-slide img {
        width: 150% !important;
        left: auto !important
    }

    .ab-facility-text {
        font-size: clamp(2rem, 2.7vw, 2.6rem)
    }

    .ab-facility-controls {
        left: auto;
        right: 4vw;
        bottom: 48px;
        gap: 18px
    }

    .ab-facility-count strong {
        font-size: 3rem
    }

    /* why choose us: headline left, lead right, four-column row below */
    .ab-why {
        padding-top: 130px;
        padding-bottom: 130px
    }

    .ab-why-head {
        grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
        align-items: end;
        gap: 6vw;
        margin-bottom: 64px
    }

    .ab-why-list {
        grid-template-columns: repeat(4, minmax(0, 1fr))
    }

    .ab-why-list li {
        min-height: clamp(480px, 42vw, 620px)
    }

    /* alternate panels start lower for a stepped rhythm */
    .ab-why-list li:nth-child(even) {
        margin-top: 44px
    }

    /* sustainability: arch left, copy right */
    .ab-sustain {
           grid-template-columns: minmax(0px, 54fr) minmax(0px, 46fr);
        align-items: center;
        gap: 6vw;
        padding-top: 130px;
        padding-bottom: 130px
    }

    .ab-sustain-badge {
        right: -40px;
        top: 60px;
        width: 140px;
        height: 140px
    }

    /* collective model: materials → lines → hub → result */

    /* material detail appears only for the active row */

    /* mission / vision */

    /* principles: sticky heading, words scroll past */

    /* warehouse lane runs horizontally between the two names */

    /* closing: headline left, copy + actions right */
    .ab-closing {
        padding: 130px 4vw 0
    }

    .ab-closing-copy {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
        grid-template-rows: auto 1fr;
        column-gap: 6vw;
        align-items: end
    }

    .ab-closing h2 {
        grid-row: 1 / span 2;
        margin: 0;
        font-size: clamp(3rem, 5.4vw, 5rem);
        line-height: 1.08
    }

    .ab-closing-actions {
        margin-top: 14px
    }
}

/* =========================================================
   PINNED STORYTELLING — desktop with motion allowed only
   ========================================================= */

/* =========================================================
   REDUCED MOTION — everything at its final, readable state
   ========================================================= */
@media (prefers-reduced-motion: reduce) {
    .ab-values-run {
        flex-wrap: wrap;
        width: auto
    }

    [class^="ab-"], [class*=" ab-"],
    [class^="ab-"]::before, [class*=" ab-"]::before,
    [class^="ab-"]::after, [class*=" ab-"]::after {
        animation: none !important
    }

    [data-reveal],
    .ab-why-list li,
    .ab-sustain-arch img {
        opacity: 1;
        transform: none;
        transition: none
    }

    .ab-hero-frame::after {
        display: none
    }
}
